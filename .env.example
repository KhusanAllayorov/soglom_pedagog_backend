# Lokal ishlab chiqish uchun (SQLite):
DATABASE_URL=sqlite:///./soglom_pedagog.db

# Railway / production uchun (PostgreSQL) — Railway avtomatik beradi:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# JWT maxfiy kaliti — productionda uzun tasodifiy qator qo'ying:
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# Token amal qilish muddati (daqiqa) — 43200 = 30 kun:
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Admin amallar (parol tiklash) uchun maxfiy kalit — uzun tasodifiy qator qo'ying:
ADMIN_KEY=change-this-admin-key
